# ==========================================
# Example: Keep Artifact Folder Structure
# ==========================================
# Ignore all binaries but keep config
artifacts/**/*.dll
artifacts/**/*.exe
artifacts/**/*.pdb
artifacts/**/*.cache

# Allow configs
!artifacts/**/*.config
!artifacts/**/*.json
!artifacts/**/*.xml
!artifacts/**/*.yaml
!artifacts/**/*.yml